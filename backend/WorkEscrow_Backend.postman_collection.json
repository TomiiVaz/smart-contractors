    {
      "key": "aliceWallet",
      "value": "0x5B38Da6a701c568545dCfcB03FcB875f56beddC4",
      "type": "string"
    },
    {
      "key": "bobWallet",
      "value": "0xAb8483F64d9C6d1EcF9b849Ae677dD3315835cb2",
      "type": "string"
    },
    {
      "key": "charlieWallet",
      "value": "0x4B20993Bc481177ec7E8f571ceCaE8A9e22C02db",
      "type": "string"
    },
    {
      "key": "dianaWallet",
      "value": "0x78731D3Ca6b7E34aC0F824c42a7cC18A495cabAb",
